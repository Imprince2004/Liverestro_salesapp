# LiveRestro CRM Backend Production Environment Variables

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port
PORT=5000

# PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liverestro
PG_SSL=false

# Connection Pool Settings
DB_POOL_MAX=25
DB_POOL_MIN=4
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=3000

# Security & JWT
JWT_SECRET=replace_with_strong_random_256_bit_secret_in_production
JWT_REFRESH_SECRET=replace_with_strong_random_256_bit_refresh_secret
JWT_EXPIRES_IN=7d

# Google Authenticator (TOTP)
TOTP_ISSUER=LiveRestro CRM
TOTP_APP_NAME=LiveRestro Sales

# CORS Permitted Origins (comma separated or * for all)
CORS_ORIGIN=*
